// Gemini audio transcription endpoint
app.post("/api/ai/transcribe", async (req, res) => {
  try {
    const ai = getGeminiClient();

    if (!ai) {
      return res.status(500).json({
        error: "Gemini API key is not configured on the server.",
      });
    }

    const { audioBase64, mimeType, language } = req.body;

    if (!audioBase64) {
      return res.status(400).json({
        error: "No audio data received.",
      });
    }

    const safeMimeType =
      typeof mimeType === "string" && mimeType.trim()
        ? mimeType
        : "audio/webm";

    const selectedLanguage =
      typeof language === "string" && language.trim()
        ? language
        : "English";

    const prompt = `
You are the speech transcription engine for CASE LINE, a multilingual patient history-taking system.

Transcribe the patient's spoken audio accurately.

Primary patient language: ${selectedLanguage}

Requirements:
- Preserve the patient's meaning exactly.
- Support natural code-switching such as Tamil-English, Hinglish, and other Indian-language code-switching.
- Do not diagnose the patient.
- Do not summarize.
- Do not add medical information that was not spoken.
- Preserve clinically important words, numbers, medicines, symptoms, durations, body locations, severity, and negations.
- Return only the transcription text.
`;

    const response = await callGeminiWithRetry(
      ai,
      (model) =>
        ai.models.generateContent({
          model,
          contents: [
            {
              role: "user",
              parts: [
                { text: prompt },
                {
                  inlineData: {
                    mimeType: safeMimeType,
                    data: audioBase64,
                  },
                },
              ],
            },
          ],
        })
    );

    const transcript =
      response.text?.trim() ||
      response.candidates?.[0]?.content?.parts
        ?.map((part: any) => part.text || "")
        .join("")
        .trim() ||
      "";

    if (!transcript) {
      return res.status(422).json({
        error: "Gemini returned an empty transcription.",
      });
    }

    return res.json({
      success: true,
      transcript,
      language: selectedLanguage,
    });
  } catch (error: any) {
    console.error("CASE LINE Gemini transcription error:", error);

    return res.status(500).json({
      error: "Audio transcription failed.",
      details: String(error?.message || error),
    });
  }
});
// Vite middleware & Static serving
async function startServer() {
  if (process.env.NODE_ENV !== "production") {
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: "spa",
    });
    app.use(vite.middlewares);
  } else {
    const distPath = path.join(process.cwd(), "dist");
    app.use(express.static(distPath));
    app.get("*", (_req, res) => {
      res.sendFile(path.join(distPath, "index.html"));
    });
  }

  app.listen(PORT, "0.0.0.0", () => {
    console.log(`CaseLine server running on http://0.0.0.0:${PORT}`);
  });
}

startServer();

